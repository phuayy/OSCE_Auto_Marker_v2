# OSCE AI Marker environment template.
# Copy this file to .env and fill in private values locally or in your deployment platform.
# Never commit .env.

# -----------------------------------------------------------------------------
# Server / upload settings
# -----------------------------------------------------------------------------
API_PORT=8787
MAX_VIDEO_UPLOAD_MB=2048
MAX_CASE_STUDY_UPLOAD_MB=50
CORS_ALLOW_ORIGINS=*

# ---------------------------------------------------------------------------
# Data directories
# ---------------------------------------------------------------------------
# APP_ROOT: root of the project on disk. Defaults to the parent of fastapi_backend/.
# Override in production to keep data outside the repository checkout.
APP_ROOT=

# STORAGE_ROOT: base directory for ALL persistent data (sessions, jobs, scores,
# audio, transcripts). Defaults to {APP_ROOT}/storage.
# Override to an absolute path (e.g. /var/data/osce) to keep data off the repo disk.
STORAGE_ROOT=

# ---------------------------------------------------------------------------
# Cloud-ready source upload storage
# ---------------------------------------------------------------------------
# STORAGE_BACKEND picks how uploaded videos and case studies are stored:
#   local - bytes are relayed through this API, assembled under
#           OBJECT_STORAGE_ROOT and served from /media. The development and
#           single-box default.
#   gcs   - the browser PUTs straight at a resumable upload session URI this
#           server mints, so a multi-gigabyte transfer survives an API restart
#           and resumes at its last committed offset. Workers pull objects onto
#           local disk on demand (ffmpeg and WhisperX are path-based), keeping a
#           checksum-verified cache under GCS_CACHE_ROOT.
# OBJECT_STORAGE_ROOT overrides only the local raw-file object store.
STORAGE_BACKEND=local
OBJECT_STORAGE_ROOT=
OBJECT_BUCKET=
OBJECT_PREFIX=
SIGNED_URL_TTL_SECONDS=900
UPLOAD_PART_SIZE_MB=8
UPLOAD_SESSION_TTL_HOURS=24

# Google Cloud Storage backend (STORAGE_BACKEND=gcs). Needs the
# google-cloud-storage package and Application Default Credentials. Signing the
# playback URLs requires a credential that can sign: a service-account key file,
# or iam.serviceAccounts.signBlob on the attached service account.
GCS_BUCKET=
GCS_PROJECT=
# Origin of the site serving the SPA. Without it the browser's cross-origin PUT
# at the resumable session URI is blocked by CORS.
GCS_UPLOAD_ORIGIN=
GCS_SIGNED_URL_TTL_SECONDS=3600
# Local scratch holding materialised bucket objects; defaults to
# storage/cache/objects. Give a worker a persistent path so retries reuse it.
GCS_CACHE_ROOT=

# App metadata/result database. Leave empty for local development to use
# storage/database/osce_marker.sqlite3. Set this only when PostgreSQL is running,
# for example with the local Docker compose service or a managed database.
APP_DATABASE_URL=
# Example:
# APP_DATABASE_URL=postgresql://osce_app:osce_app_dev_password@localhost:5432/osce_marker

# Backward-compatible alias used only when APP_DATABASE_URL is empty. Do not use
# this for Hatchet's control-plane DATABASE_URL in the app process.
DATABASE_URL=

# Run "alembic upgrade head" during startup, so one command still brings the app
# up on a fresh machine. Set false where migrations are a deliberate deploy step
# (cd fastapi_backend && alembic upgrade head) â€” notably when the API and a
# Hatchet worker boot together and only one should touch the schema.
DB_AUTO_MIGRATE=true

# local auto-start runs queued jobs in-process for development only. Production
# should use JOB_QUEUE_BACKEND=hatchet and run the Hatchet worker separately.
JOB_QUEUE_BACKEND=local
LOCAL_JOB_AUTO_START=true
JOB_WORKER_CONCURRENCY=2
RECOVER_RUNNING_JOBS_ON_STARTUP=true

# Hatchet client configuration for JOB_QUEUE_BACKEND=hatchet.
# Create this token in the Hatchet dashboard for your tenant.
HATCHET_CLIENT_TOKEN=
HATCHET_CLIENT_HOST_PORT=localhost:7077
# Hatchet Lite/self-hosted without TLS uses this value.
HATCHET_CLIENT_TLS_STRATEGY=none
HATCHET_WORKER_NAME=osce-ai-marker-worker
HATCHET_JOB_RETRIES=2
HATCHET_JOB_SCHEDULE_TIMEOUT_MINUTES=60
HATCHET_JOB_EXECUTION_TIMEOUT_MINUTES=240

# Local PostgreSQL compose settings. These are consumed by
# docker-compose.postgres.yml and docker-compose.hatchet.yml, not by the FastAPI
# app directly. The FastAPI app uses APP_DATABASE_URL above.
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres_admin_dev_password
POSTGRES_ADMIN_DB=postgres
APP_POSTGRES_USER=osce_app
APP_POSTGRES_PASSWORD=osce_app_dev_password
APP_POSTGRES_DB=osce_marker
APP_POSTGRES_HOST=127.0.0.1
APP_POSTGRES_PORT=5432

# Local Hatchet Lite compose settings. These are consumed by
# docker-compose.hatchet.yml, not by the FastAPI app directly.
HATCHET_POSTGRES_USER=hatchet
HATCHET_POSTGRES_PASSWORD=hatchet
HATCHET_POSTGRES_DB=hatchet
HATCHET_POSTGRES_PORT=5433
HATCHET_SERVER_PORT=8888
HATCHET_GRPC_PORT=7077

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
AUTH_TOKEN_TTL_SECONDS=28800
AUTH_BCRYPT_ROUNDS=12

# Used only when bootstrapping local development credentials.
# For production, prefer setting AUTH_SECRET and a pre-generated password hash in your platform secrets.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me
AUTH_SECRET=

# -----------------------------------------------------------------------------
# Model provider secrets
# -----------------------------------------------------------------------------
NVIDIA_API_KEY=
WHISPERX_HF_TOKEN=

# -----------------------------------------------------------------------------
# NVIDIA model/scoring settings
# -----------------------------------------------------------------------------
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_NAME=nvidia/nemotron-3-super-120b-a12b
NVIDIA_COMM_MODEL_NAME=
NVIDIA_FALLBACK_MODELS=
NVIDIA_TEMPERATURE=0.2
NVIDIA_TOP_P=0.9
NVIDIA_MAX_TOKENS=24576
NVIDIA_ENABLE_THINKING=false
NVIDIA_COMMUNICATION_ENABLE_THINKING=true
NVIDIA_REASONING_BUDGET=16384
NVIDIA_REQUEST_TIMEOUT_SECONDS=360

# -----------------------------------------------------------------------------
# Local binary paths
# -----------------------------------------------------------------------------
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# Leave empty to auto-detect the project virtual environment when present.
SCORER_PYTHON_BIN=
WHISPERX_BIN=whisperx

# -----------------------------------------------------------------------------
# WhisperX
# -----------------------------------------------------------------------------
WHISPERX_LANGUAGE=en
# Whisper checkpoint to transcribe with. large-v3 is the accuracy default;
# distil-large-v3 halves latency if transcription is too slow. (The WhisperX CLI
# default is "small" — always set this explicitly.)
WHISPERX_MODEL=large-v3
# Use "cpu" if no NVIDIA CUDA GPU is available; "cuda" for GPU-accelerated transcription.
WHISPERX_DEVICE=cuda
# Compute precision for the WhisperX model. "float16" (~3 GB) matches the native
# large-v3 weight precision and is the accuracy default; "float32" only upcasts the
# same weights for ~2x the VRAM. Use "int8" (~1.5 GB) on low-VRAM cards (<=4 GB)
# where float16 + diarization does not fit. On CPU, float16 is auto-downgraded to
# int8 (CTranslate2 CPU has no float16).
WHISPERX_COMPUTE_TYPE=float16
# Transcription batch size. The WhisperX CLI default of 8 OOMs large-v3 on <=6 GB
# cards once the pyannote diarisation models share the device. Raise on a bigger GPU.
WHISPERX_BATCH_SIZE=1
# Diarisation speaker bounds. An OSCE station records a known cast (student +
# simulated patient), and telling pyannote the count stops one person being
# split across two labels. Raise the maximum when an examiner also speaks;
# set either to 0 to let WhisperX estimate the speaker count itself.
WHISPERX_MIN_SPEAKERS=2
WHISPERX_MAX_SPEAKERS=2
# Seconds of VAD audio merged into one decode chunk (WhisperX default 30).
# 20 keeps chunks inside a couple of speaker turns. 0 = WhisperX default.
WHISPERX_CHUNK_SIZE=20
# Emit "Progress: 42.10%..." lines so session cards show real transcription
# progress instead of only elapsed seconds.
WHISPERX_PRINT_PROGRESS=true
WHISPERX_OUTPUT_FORMAT=all
WHISPERX_LOG_HEARTBEAT_MS=5000
# ffmpeg audio filter chain applied to the dedicated WhisperX input WAV
# (16 kHz mono). Empty string = feed the extracted MP3 unfiltered.
WHISPERX_AUDIO_FILTERS=highpass=f=80,loudnorm
# Optional register-priming sentence passed as --initial_prompt. Empty = off.
WHISPERX_INITIAL_PROMPT=
# Minimum difflib similarity ratio for corpus-term transcript corrections.
TRANSCRIPT_CORRECTION_MIN_RATIO=0.84

# -----------------------------------------------------------------------------
# Transcription engine
# -----------------------------------------------------------------------------
# Engine used when the settings screen has no stored selection: whisperx or
# canary-qwen. The operator's choice in Settings overrides this per run.
TRANSCRIPTION_ENGINE=whisperx

# --- Canary-Qwen (NVIDIA NeMo SALM) ---
# Optional engine: needs `pip install "nemo_toolkit[asr]>=2.5"` in the same
# environment as the scorers. It transcribes text only, so the pipeline adds a
# pyannote pass to label speakers.
CANARY_MODEL=nvidia/canary-qwen-2.5b
# The model was trained on utterances of at most 40 s; longer windows lose
# accuracy, so long recordings are decoded in overlapping chunks.
CANARY_CHUNK_SECONDS=30
CANARY_OVERLAP_SECONDS=2
CANARY_BATCH_SIZE=1
CANARY_DEVICE=auto
CANARY_DIARIZE=true
CANARY_PROMPT=Transcribe the following:
CANARY_AUDIO_FILTERS=highpass=f=80

# --- Standalone diarisation (engines that cannot label speakers) ---
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
DIARIZATION_DEVICE=auto

# -----------------------------------------------------------------------------
# Audio extraction and professionalism
# -----------------------------------------------------------------------------
AUDIO_MP3_SAMPLE_RATE=48000
AUDIO_MP3_VBR_QUALITY=0
AUDIO_PROF_STUDENT_SPEAKER=
ENABLE_AUDIO_PROFESSIONALISM=true

# -----------------------------------------------------------------------------
# Scoring feature toggles
# -----------------------------------------------------------------------------
ENABLE_SCORING=true
ENABLE_COMMUNICATION_SCORING=true
# After WhisperX transcript generation, run clinical/content scoring in parallel
# with the audio-professionalism -> communication scoring branch. Set false if
# your model provider rate-limits concurrent scoring calls.
PARALLEL_SCORING=true

# -----------------------------------------------------------------------------
# Long-video bell/silence detection
# -----------------------------------------------------------------------------
AUTO_CROP_MIN_CLIP_SECONDS=0.5
ENABLE_PYTHON_BELL_DETECTOR=true
BELL_END_OFFSET_SECONDS=5
BELL_START_OFFSET_SECONDS=0
BELL_DETECTOR_SAMPLE_RATE=22050
BELL_DETECTOR_CHUNK_SECONDS=60
PYTHON_BELL_MIN_GAP_SECONDS=240
PYTHON_BELL_MIN_CLIPS=1
PYTHON_BELL_MAX_CLIPS=16
PYTHON_BELL_EXPECTED_COUNT=0
PYTHON_BELL_PAIRING_MODE=pair
PYTHON_DETECTOR_MODE=hybrid
PYTHON_EXPECTED_STUDENTS=0
PYTHON_MIN_SILENCE_GAP_SECONDS=6

# -----------------------------------------------------------------------------
# Long-video person-presence segmentation (RT-DETR, scripts/detect_human_segments.py)
# -----------------------------------------------------------------------------
# The upload form chooses bells|person per session; AUTO_CROP_SEGMENTATION is
# the server default when the upload did not choose. Person detection falls
# back to bell detection automatically if the vision stack is unavailable.
ENABLE_HUMAN_DETECTOR=true
AUTO_CROP_SEGMENTATION=bells
# Clip padding applied by the backend around detected person segments.
HUMAN_SEGMENTS_END_OFFSET_SECONDS=2
HUMAN_SEGMENTS_START_OFFSET_SECONDS=0
# Detector tuning (read directly by the script from the environment).
# HUMAN_SEGMENTS_SAMPLE_FPS=1.0
# HUMAN_SEGMENTS_MIN_PEOPLE=2
# HUMAN_SEGMENTS_END_AFTER_SECONDS=8
# HUMAN_SEGMENTS_START_AFTER_SECONDS=4
# HUMAN_SEGMENTS_FLICKER_TOLERANCE_SECONDS=2
# HUMAN_SEGMENTS_CONFIDENCE=0.5
# HUMAN_SEGMENTS_MODEL=PekingU/rtdetr_v2_r18vd
# HUMAN_SEGMENTS_DEVICE=auto
# HUMAN_SEGMENTS_BATCH_SIZE=8


# ---------------------------------------------------------------------------
# Outbound notification webhooks
#
# When a task finishes (or fails) the backend POSTs a signed JSON payload to
# every registered endpoint. Endpoints are managed in the UI under Settings ->
# Outbound Webhooks; these settings govern how delivery behaves.
#
# The in-app notification bell does NOT use these — the browser is updated by
# server push over /api/events. Webhooks are only for reaching other systems.
# ---------------------------------------------------------------------------
# Per-attempt HTTP timeout, in seconds.
WEBHOOK_TIMEOUT_SECONDS=10
# Total attempts per event per endpoint (1 disables retries). Only transport
# errors, 5xx and 429 are retried; a 4xx is treated as a deliberate refusal.
WEBHOOK_MAX_ATTEMPTS=3
# Allow webhook URLs pointing at loopback/private addresses. OFF by default:
# the server making a user-supplied request is an SSRF primitive, and
# http://169.254.169.254/ would expose cloud instance credentials. Turn this on
# only to test against a listener on your own machine.
WEBHOOK_ALLOW_PRIVATE_URLS=false
# User-Agent sent with each delivery.
# WEBHOOK_USER_AGENT=OSCE-AI-Marker-Webhook/1.0

# ---------------------------------------------------------------------------
# Read-through cache
#
# Hot projections (the session index, the notification feed) are served from
# memory and evicted by database change announcements rather than by a clock —
# on PostgreSQL a trigger fires pg_notify on commit, the API process turns that
# into an eviction, and the next read rebuilds. Reads fall back to the database
# whenever an entry is absent or its change-counter token has moved, so a hit
# can never be stale.
#
# Leave enabled. Turn off only to isolate a suspected staleness bug: every read
# then goes to the database, which is correct but materially slower under load.
# ---------------------------------------------------------------------------
CACHE_ENABLED=true

