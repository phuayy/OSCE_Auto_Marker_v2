# Production overlay for the OSCE AI Marker Windows host.
#
# This is NOT a complete .env — it lists only the keys a production Windows
# deployment behind Cloudflare Tunnel changes from .env.example's development
# defaults. Copy .env.example to .env on the host first, then apply every
# line below on top of it (same KEY=VALUE lines, same file). Every key here
# either exists verbatim in .env.example or is read by name in
# fastapi_backend/app/core/config.py — see fastapi_backend/tests/test_deploy_assets.py,
# which pins that. No secrets are filled in; every <generate: ...> /
# <placeholder> value must be replaced before this file is usable.
#
# See CLAUDE.md "Deploying on one VM", "Key Environment Variables" and
# docs/deployment-vm.md for the reasoning behind each of these.

# -----------------------------------------------------------------------------
# Deployment shape
# -----------------------------------------------------------------------------
# Refuses to start with an actively unsafe combination (currently just
# PROTECT_MEDIA_ENDPOINTS=false). Never set this in local development.
ENVIRONMENT=production

# -----------------------------------------------------------------------------
# Server / networking — API stays on loopback; cloudflared is the only thing
# that talks to it from outside this box (forwards to 127.0.0.1:8787).
# -----------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8787
# The API serves dist/ itself: one process, one origin, no CORS to configure
# for the browser. FRONTEND_DIST_DIR points at the junction Deploy-Release.ps1
# swaps on every frontend release — see deploy/windows/README.md.
SERVE_FRONTEND=true
FRONTEND_DIST_DIR=D:\osce\current-dist
# Public https origin the browser loads from and every emailed link starts
# with. MUST match the Cloudflare Tunnel hostname exactly.
APP_PUBLIC_URL=https://osce.example.edu
# Same origin as above — the frontend is served from this same origin, so
# this only silences the wildcard-origin startup warning.
CORS_ALLOW_ORIGINS=https://osce.example.edu

# Cloudflare Tunnel is a reverse proxy in front of this app (one hop): trust
# X-Forwarded-For only from loopback, where cloudflared's local connection
# terminates, and read the real client address from the header Cloudflare
# actually sets. TRUSTED_CLIENT_IP_HEADER is being added to app/core/config.py
# and .env.example by a separate change in this repo; if it is not present
# yet when you apply this file, wait for that change before deploying to a
# host that must resolve real client IPs (rate limiting still works either
# way — it just keys on the tunnel's loopback address until then).
TRUSTED_PROXY_COUNT=1
TRUSTED_PROXY_IPS=127.0.0.1,::1
TRUSTED_CLIENT_IP_HEADER=CF-Connecting-IP

# Once this deployment is reachable only over https (which it is, entirely
# through Cloudflare Tunnel — nothing here answers plain HTTP from outside):
# turn on HSTS. Do NOT enable this before the tunnel/DNS is confirmed working
# over https, or a browser that saw the header will refuse to fall back.
ENABLE_HSTS=true

# -----------------------------------------------------------------------------
# Security posture
# -----------------------------------------------------------------------------
PROTECT_MEDIA_ENDPOINTS=true
API_DOCS_ENABLED=false

# -----------------------------------------------------------------------------
# Database — Alembic runs as an explicit deploy step (Deploy-Release.ps1),
# AFTER a backup, never implicitly at process start. With DB_AUTO_MIGRATE=false
# the API refuses to start if the database is not already at head, which is
# exactly the safety property a one-box deployment with no separate migration
# stage needs.
# -----------------------------------------------------------------------------
DB_AUTO_MIGRATE=false
# PostgreSQL is recommended even for a single always-on box: SQLite's single
# writer serialises upload parts, job events and session progress under
# concurrent markers (see docs/deployment-vm.md). SQLite remains acceptable
# for a single-marker pilot. Use whichever variable this checkout's
# .env.example documents as primary (APP_DATABASE_URL); DATABASE_URL is kept
# only as a legacy fallback when APP_DATABASE_URL is empty.
# The scheme must be one app.database.db_url.normalize_database_url accepts —
# postgres(ql), postgresql+psycopg (this repo installs psycopg, not asyncpg),
# sqlite or sqlite+aiosqlite. Anything else -- a "+asyncpg" driver included --
# refuses to start with a clear error naming the scheme it got, rather than
# (as it once did) silently treating the whole URL string as a SQLite file
# path and booting against a fresh, empty local database with no error at all.
APP_DATABASE_URL=postgresql+psycopg://osce_app:<generate: a strong password>@127.0.0.1:5432/osce_marker

# -----------------------------------------------------------------------------
# Job queue — Hatchet, dispatched to a dedicated worker service (OsceMarkerWorker)
# that is the one process running GPU pipeline steps. The API service runs no
# jobs under this backend (see CLAUDE.md "Job Queue": scaling past one JOB_QUEUE_BACKEND=local
# API process means Hatchet). Hatchet's own control-plane (hatchet-lite +
# hatchet-postgres) runs in Docker on this same box, loopback-only — see
# deploy/windows/README.md "Hatchet in Docker" and the trust-model note at the
# top of docker-compose.hatchet.yml.
# -----------------------------------------------------------------------------
JOB_QUEUE_BACKEND=hatchet
# Minted in the hatchet-lite dashboard (http://127.0.0.1:8888) after first
# bringing the two hatchet-* Docker services up — see
# deploy/windows/Start-OsceStack.ps1. Treat it as a secret.
HATCHET_CLIENT_TOKEN=<generate: from the hatchet-lite dashboard at http://127.0.0.1:8888>
# Loopback only: nothing outside this box ever talks to Hatchet directly.
HATCHET_CLIENT_HOST_PORT=localhost:7077
# hatchet-lite terminates plain gRPC; TLS between this process and Hatchet is
# unnecessary because both ends never leave 127.0.0.1 on this box (see
# docker-compose.hatchet.yml's top-of-file trust-model comment — it documents
# exactly this "none" choice for a loopback-only control plane).
HATCHET_CLIENT_TLS_STRATEGY=none
HATCHET_WORKER_NAME=osce-ai-marker-worker
# Password for the hatchet-postgres container (docker-compose.hatchet.yml) —
# distinct from APP_DATABASE_URL's password above. Not read by the API/worker
# process itself; it configures the Docker Compose stack Start-OsceStack.ps1
# brings up.
HATCHET_POSTGRES_PASSWORD=<generate: a strong password, used only by docker-compose.hatchet.yml>
# Never used on this host — Start-OsceStack.ps1 starts only hatchet-postgres and
# hatchet-lite, never the compose file's app-postgres (the app database is the
# native Windows PostgreSQL service). It must still be non-empty: Compose
# interpolates the WHOLE file before selecting services, and app-postgres
# declares ${APP_POSTGRES_PASSWORD:?...}, so leaving it unset makes
# `docker compose up -d hatchet-postgres hatchet-lite` fail with "required
# variable APP_POSTGRES_PASSWORD is missing a value" and the queue never boots.
APP_POSTGRES_PASSWORD=<generate: any random value; the container it configures is never started here>

# -----------------------------------------------------------------------------
# Storage — local backend, data kept off the repo checkout so a redeploy
# (git checkout --detach to a new release commit) never touches it.
# -----------------------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_ROOT=D:\osce\data\storage

# HuggingFace model cache (WhisperX / pyannote / Canary-Qwen weights), kept
# outside the repo checkout for the same reason as STORAGE_ROOT — a redeploy
# must never force a multi-gigabyte re-download. Not an app config.py setting;
# it is the standard HuggingFace Hub cache-location variable, read directly
# by the transformers/huggingface_hub libraries the pipeline depends on.
HF_HOME=D:\osce\data\cache\hf

# One GPU on this box: transcription and person detection share it and must
# not run concurrently (see CLAUDE.md "The GPU is leased, the queue is not
# enough").
GPU_SLOTS=1

# -----------------------------------------------------------------------------
# Outbound email — invitations and password resets need real delivery in
# production; the console backend only logs the message server-side, which is
# useless once markers are remote users behind Cloudflare.
# -----------------------------------------------------------------------------
EMAIL_BACKEND=smtp
EMAIL_FROM=OSCE AI Marker <no-reply@example.edu>
SMTP_HOST=<smtp relay hostname, e.g. smtp.office365.com>
SMTP_PORT=587
SMTP_USERNAME=<smtp username>
SMTP_PASSWORD=<generate: from your mail provider>
SMTP_STARTTLS=true
SMTP_USE_TLS=false

# -----------------------------------------------------------------------------
# Uploads — 8 MB parts stay well under Cloudflare's 100 MB per-request limit
# on the Free/Pro plans (see deploy/cloudflared/README.md). Do NOT raise this
# anywhere near 100; a part that Cloudflare rejects fails the whole transfer,
# not just one retry.
# -----------------------------------------------------------------------------
UPLOAD_PART_SIZE_MB=8

# -----------------------------------------------------------------------------
# Secrets — generate real values before first boot. Never commit the filled
# .env; keep a copy of these two in a password manager (see
# docs/deployment-vm.md "Backup and data retention" — restoring the database
# without them makes every saved provider key unreadable).
# -----------------------------------------------------------------------------
AUTH_SECRET=<generate: openssl rand -base64 48>
CREDENTIAL_ENCRYPTION_KEY=<generate: openssl rand -base64 32>
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=<generate: a strong first-boot password, change after first login>
DEFAULT_ADMIN_EMAIL=<admin's email address>
