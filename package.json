{
  "name": "osce-ai-marker-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:api": "uv run --no-sync python scripts/run_api.py",
    "dev:worker": "uv run --no-sync python scripts/run_hatchet_worker.py",
    "py:sync": "uv sync",
    "py:sync:canary": "uv sync --group canary",
    "py:lock": "uv lock",
    "db:config": "docker compose -f docker-compose.postgres.yml config",
    "db:up": "docker compose -f docker-compose.postgres.yml up -d",
    "db:down": "docker compose -f docker-compose.postgres.yml down",
    "db:logs": "docker compose -f docker-compose.postgres.yml logs -f postgres",
    "db:ps": "docker compose -f docker-compose.postgres.yml ps",
    "db:reset": "uv run --no-sync python scripts/reset_db.py",
    "db:reset:all": "uv run --no-sync python scripts/reset_db.py --all",
    "db:check": "uv run --no-sync python scripts/check_database.py",
    "test:api": "uv run --no-sync python -m pytest fastapi_backend/tests",
    "test:ui": "node --test \"test/*.test.mjs\"",
    "lint": "npm run lint:ui && npm run lint:api && npm run enums:check",
    "lint:ui": "eslint src",
    "lint:api": "uv run --no-sync ruff check fastapi_backend/app scripts",
    "enums:generate": "uv run --no-sync python scripts/generate_enums.py",
    "enums:check": "uv run --no-sync python scripts/generate_enums.py --check",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "framer-motion": "^13.4.4",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.1"
  }
}
